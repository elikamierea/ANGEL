{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "vs-release",
      "displayName": "VS 2022 x64 Release",
      "generator": "Visual Studio 17 2022",
      "binaryDir": "${sourceDir}/build",
      "architecture": "x64",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release",
        "ANGEL_ENABLE_PCH": "ON",
        "ANGEL_ENABLE_UNITY_BUILD": "ON",
        "ANGEL_ENABLE_SCCACHE": "ON"
      }
    },
    {
      "name": "ninja-release",
      "displayName": "Ninja Release (fast iterative)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ANGEL_ENABLE_PCH": "ON",
        "ANGEL_ENABLE_UNITY_BUILD": "ON",
        "ANGEL_ENABLE_SCCACHE": "ON",
        "CMAKE_MAKE_PROGRAM": "${sourceDir}/tools/ninja/ninja.exe"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "build-vs-release",
      "configurePreset": "vs-release",
      "configuration": "Release",
      "jobs": 0
    },
    {
      "name": "build-ninja-release",
      "configurePreset": "ninja-release",
      "jobs": 0
    }
  ]
}
